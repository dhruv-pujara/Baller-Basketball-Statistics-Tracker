<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="263.0" prefWidth="431.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cpsc233.project.cpsc233javafxfinal.MainInterfaceController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Back to main" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <AnchorPane prefHeight="286.0" prefWidth="342.0">
         <children>
            <Label fx:id="teamText" layoutX="14.0" layoutY="5.0" prefHeight="18.0" prefWidth="163.0" text="Adding game for team {TEAM]" />
            <Button layoutX="332.0" layoutY="173.0" mnemonicParsing="false" onAction="#switchToMainInterface" text="Submit" />
            <Label fx:id="playerText" layoutX="95.0" layoutY="23.0" text="Enter stats for player [PLAYER]:" />
            <TextField fx:id="points" layoutX="176.0" layoutY="47.0" />
            <TextField fx:id="assists" layoutX="176.0" layoutY="78.0" />
            <TextField fx:id="rebounds" layoutX="176.0" layoutY="173.0" />
            <TextField fx:id="steals" layoutX="176.0" layoutY="142.0" />
            <TextField fx:id="blocks" layoutX="176.0" layoutY="109.0" />
            <Label layoutX="111.0" layoutY="51.0" prefHeight="17.0" prefWidth="39.0" text="Points" />
            <Label layoutX="111.0" layoutY="82.0" text="Assists" />
            <Label layoutX="112.0" layoutY="113.0" text="Blocks" />
            <Label layoutX="114.0" layoutY="146.0" text="Steals" />
            <Label layoutX="104.0" layoutY="177.0" text="Rebounds" />
         </children>
      </AnchorPane>
      <HBox prefHeight="23.0" prefWidth="342.0">
         <children>
            <AnchorPane prefHeight="23.0" prefWidth="342.0">
               <children>
                  <Label fx:id="addGameErrortext" layoutX="7.0" layoutY="3.0" prefHeight="18.0" prefWidth="328.0" text="Adding a game..." />
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </children>
</VBox>
