<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="263.0" prefWidth="431.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cpsc233.project.cpsc233javafxfinal.MainInterfaceController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <AnchorPane prefHeight="286.0" prefWidth="342.0">
         <children>
            <Label layoutX="14.0" layoutY="14.0" prefHeight="18.0" prefWidth="163.0" text="Add game for team {TEAM]" />
            <Button layoutX="332.0" layoutY="211.0" mnemonicParsing="false" onAction="#switchToMainInterface" text="Back to main" />
            <Label layoutX="14.0" layoutY="32.0" text="Enter stats for player [PLAYER]:" />
            <Label layoutX="25.0" layoutY="64.0" prefHeight="22.0" prefWidth="76.0" text="Enter Points:" />
            <Label layoutX="24.0" layoutY="91.0" prefHeight="22.0" prefWidth="76.0" text="Enter Assists:" />
            <Label layoutX="29.0" layoutY="120.0" prefHeight="22.0" prefWidth="76.0" text="Enter Steals:" />
            <Label layoutX="26.0" layoutY="147.0" prefHeight="22.0" prefWidth="76.0" text="Enter Blocks:" />
            <Label layoutX="6.0" layoutY="175.0" prefHeight="22.0" prefWidth="96.0" text="Enter Rebounds:" />
            <TextField fx:id="points" layoutX="96.0" layoutY="62.0" prefHeight="11.0" prefWidth="86.0" />
            <TextField fx:id="assisits" layoutX="96.0" layoutY="89.0" prefHeight="11.0" prefWidth="86.0" />
            <TextField fx:id="steals" layoutX="96.0" layoutY="117.0" prefHeight="11.0" prefWidth="86.0" />
            <TextField fx:id="blocks" layoutX="96.0" layoutY="145.0" prefHeight="11.0" prefWidth="86.0" />
            <TextField fx:id="rebounds" layoutX="96.0" layoutY="173.0" prefHeight="11.0" prefWidth="86.0" />
            <Button layoutX="96.0" layoutY="211.0" mnemonicParsing="false" onAction="#submitGameStats" prefHeight="22.0" prefWidth="86.0" text="Submit" />
         </children>
      </AnchorPane>
      <HBox prefHeight="23.0" prefWidth="342.0">
         <children>
            <AnchorPane prefHeight="23.0" prefWidth="342.0">
               <children>
                  <Label fx:id="addGameErrortext" layoutX="7.0" layoutY="3.0" prefHeight="18.0" prefWidth="328.0" text="Error go here" />
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </children>
</VBox>
