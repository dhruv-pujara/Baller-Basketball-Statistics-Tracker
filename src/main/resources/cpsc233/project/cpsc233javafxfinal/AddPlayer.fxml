<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="286.0" prefWidth="456.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cpsc233.project.cpsc233javafxfinal.addPlayerController">
   <children>
      <MenuBar fx:id="helpAddPlayer" style="-fx-background-color: #A9AAAF; -fx-font-family: DejaVu Sans; -fx-font-weight: Bold;">
        <menus>
          <Menu mnemonicParsing="false" onAction="#addPlayerHelp" text="Help" />
        </menus>
      </MenuBar>
      <AnchorPane prefHeight="236.0" prefWidth="458.0">
         <children>
            <TextField fx:id="playerName" layoutX="236.0" layoutY="61.0" prefHeight="26.0" prefWidth="138.0" />
            <TextField fx:id="playerNumber" layoutX="236.0" layoutY="103.0" prefHeight="26.0" prefWidth="138.0" />
            <Label layoutX="102.0" layoutY="65.0" prefHeight="18.0" prefWidth="118.0" text="Name of Player:">
               <font>
                  <Font name="DejaVu Sans Bold" size="12.0" />
               </font></Label>
            <Label layoutX="102.0" layoutY="109.0" prefHeight="15.0" prefWidth="118.0" text="Jersey Number:">
               <font>
                  <Font name="DejaVu Sans Bold" size="12.0" />
               </font></Label>
            <Label layoutX="148.0" layoutY="144.0" prefHeight="18.0" prefWidth="72.0" text="Position:">
               <font>
                  <Font name="DejaVu Sans Bold" size="12.0" />
               </font></Label>
            <ComboBox fx:id="positions" layoutX="236.0" layoutY="140.0" prefHeight="26.0" prefWidth="138.0" style="-fx-font-family: dejavu Sans; -fx-font-weight: bold;" />
            <Button layoutX="169.0" layoutY="176.0" mnemonicParsing="false" onMouseClicked="#addtoTeam" prefHeight="26.0" prefWidth="118.0" style="-fx-background-color: #A9AAAF;" text="Add Player">
               <font>
                  <Font name="DejaVu Sans Bold" size="12.0" />
               </font></Button>
            <Text fx:id="IntroText" layoutX="14.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Adding player to team [TEAM}" textAlignment="CENTER" wrappingWidth="428.5367431640625">
               <font>
                  <Font name="DejaVu Sans Bold" size="13.0" />
               </font>
            </Text>
            <Button layoutX="184.0" layoutY="209.0" mnemonicParsing="false" onAction="#switchToMainInterface" prefHeight="15.0" prefWidth="88.0" style="-fx-background-color: #A9AAAF;" text="Main Menu">
               <font>
                  <Font name="DejaVu Sans Bold" size="10.0" />
               </font>
            </Button>
      <!--      <Button layoutX="313.0" layoutY="14.0" mnemonicParsing="false" onAction="#addPlayerButtonClicked" prefHeight="17.0" prefWidth="39.0" text="OK!" />-->
         </children>
      </AnchorPane>
      <HBox prefHeight="29.0" prefWidth="458.0" style="-fx-background-color: #A9AAAF;">
         <children>
            <AnchorPane prefHeight="49.0" prefWidth="458.0">
               <children>
                  <Label fx:id="erroraddPlayertext" layoutX="6.0" layoutY="6.0" prefHeight="15.0" prefWidth="350.0" text="Add desired amount of players, then hit Main Menu">
                     <font>
                        <Font name="DejaVu Sans Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </HBox>
   </children>
</VBox>
